{
  "name": "rentflow",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,css}\" \"backend/src/main/java/**/*.java\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0"
  }
